{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta.schema.json",
  "title": "meta",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "leagueId": {
      "type": "integer"
    },
    "leagueName": {
      "type": "string"
    },
    "season": {
      "type": "integer"
    },
    "timezone": {
      "type": "string"
    },
    "lineupLockType": {
      "type": "string"
    },
    "currentMatchupPeriod": {
      "type": "integer",
      "minimum": 1
    },
    "matchupPeriods": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "minItems": 1
    },
    "todayET": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastRunChicagoDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSettleChicagoDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "leagueId",
    "leagueName",
    "season",
    "timezone",
    "lineupLockType",
    "currentMatchupPeriod",
    "matchupPeriods",
    "dates",
    "todayET",
    "generatedAt",
    "lastRunChicagoDate",
    "lastSettleChicagoDate"
  ],
  "additionalProperties": false
}