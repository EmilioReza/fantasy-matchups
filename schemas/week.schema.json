{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "week.schema.json",
  "title": "week",
  "type": "object",
  "properties": {
    "matchupPeriod": {
      "type": "integer"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "minItems": 1
    },
    "finalDates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "status": {
      "enum": [
        "final",
        "in_progress",
        "upcoming"
      ]
    },
    "matchups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matchupId": {
            "type": "integer"
          },
          "home": {
            "type": "object",
            "properties": {
              "teamId": {
                "type": "integer"
              },
              "actual": {
                "type": "number"
              },
              "projected": {
                "type": "number"
              },
              "gamesLeft": {
                "type": "integer",
                "minimum": 0
              },
              "winProb": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "teamId",
              "actual",
              "projected",
              "gamesLeft",
              "winProb"
            ],
            "additionalProperties": false
          },
          "away": {
            "type": "object",
            "properties": {
              "teamId": {
                "type": "integer"
              },
              "actual": {
                "type": "number"
              },
              "projected": {
                "type": "number"
              },
              "gamesLeft": {
                "type": "integer",
                "minimum": 0
              },
              "winProb": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "teamId",
              "actual",
              "projected",
              "gamesLeft",
              "winProb"
            ],
            "additionalProperties": false
          },
          "winner": {
            "enum": [
              "HOME",
              "AWAY",
              "TIE",
              null
            ]
          },
          "lineups": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "playerId": {
                    "type": "integer"
                  },
                  "slot": {
                    "type": "string"
                  },
                  "starter": {
                    "type": "boolean"
                  },
                  "fpg": {
                    "type": "number"
                  },
                  "sd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "gamesThisPeriod": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "daily": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "additionalProperties": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "dailyStatus": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "additionalProperties": {
                      "enum": [
                        "played",
                        "dnp",
                        "no_game",
                        "scheduled",
                        "not_rostered",
                        "live"
                      ]
                    }
                  },
                  "dailyStarter": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  },
                  "actual": {
                    "type": "number"
                  },
                  "remaining": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "p": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "scale": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "date",
                        "p"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "playerId",
                  "slot",
                  "starter",
                  "fpg",
                  "sd",
                  "gamesThisPeriod",
                  "daily",
                  "dailyStatus",
                  "dailyStarter",
                  "actual",
                  "remaining"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "required": [
          "matchupId",
          "home",
          "away",
          "winner",
          "lineups"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "matchupPeriod",
    "dates",
    "finalDates",
    "status",
    "matchups"
  ],
  "additionalProperties": false
}
