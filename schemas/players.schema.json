{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "players.schema.json",
  "title": "players",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "playerId": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "proTeam": {
        "type": "string"
      },
      "positions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "injuryStatus": {
        "type": "string"
      },
      "returnDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "fpgSeason": {
        "type": [
          "number",
          "null"
        ]
      },
      "fpgLast15": {
        "type": [
          "number",
          "null"
        ]
      },
      "fpgProjected": {
        "type": [
          "number",
          "null"
        ]
      },
      "sdGame": {
        "type": [
          "number",
          "null"
        ]
      },
      "gamesPlayed": {
        "type": "integer"
      },
      "fpgPrior": {
        "type": [
          "number",
          "null"
        ]
      },
      "cvGame": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "playerId",
      "name",
      "proTeam",
      "positions",
      "injuryStatus",
      "returnDate",
      "fpgSeason",
      "fpgLast15",
      "fpgProjected",
      "sdGame",
      "gamesPlayed",
      "fpgPrior",
      "cvGame"
    ],
    "additionalProperties": false
  }
}
